{
  "name": "geospark-ai-preset",
  "version": "0.1.0",
  "type": "module",
  "description": "GeoSparkAI 高中地理教师辅助 Agent 核心预设 Bundle（含讲题隔离盲做、学科思想课程方案、模拟题润色与随附考点库）",
  "keywords": [
    "geospark-ai",
    "dsh",
    "deepseek-harness",
    "agent-preset",
    "geography",
    "education"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoyuanwang220/geoteacher_preset.git",
    "directory": ".agent-presets/geo-teacher"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./plugins/core": "./plugins/core/index.js",
    "./plugins/taxonomy": "./plugins/taxonomy/index.js",
    "./plugins/bank": "./plugins/bank/index.js",
    "./plugins/analysis": "./plugins/analysis/index.js",
    "./plugins/generator": "./plugins/generator/index.js",
    "./plugins/question": "./plugins/question/index.js",
    "./plugins/solver-isolation": "./plugins/solver-isolation/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "data/config/",
    "plugins/",
    "skills/"
  ],
  "license": "MIT AND Apache-2.0",
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "optionalDependencies": {
    "geospark-ai-data": "^0.1.0"
  }
}
